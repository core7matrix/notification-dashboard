# MongoDB connection string (Atlas: Database > Connect > Drivers).
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (defaults to "notifications").
MONGODB_DB=notifications

# Key the browser extension on each VPS sends in the X-API-Key header.
INGEST_API_KEY=change-me-long-random-string

# How many notifications to keep (oldest are dropped).
MAX_NOTIFICATIONS=2000

# Pusher (https://dashboard.pusher.com, "Channels" app) for instant live updates.
# If these are left empty the dashboard falls back to polling every 5 seconds.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
